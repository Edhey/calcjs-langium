{
  "name": "@Edhey/calc-script",
  "publisher": "Edhey",
  "displayName": "CalcJs-Langium",
  "icon": "images/CalcScript-icon.png",
  "description": "* See section [TFA](https://apuntes-pl.vercel.app/labs/tfa#task-presentation-of-goals) Final Project - VsCode extension for a transpiler of a simple calculator language to JavaScript.\n* The project is based on the [Langium](https://langium.org/) framework.",
  "version": "1.1.1",
  "type": "module",
  "main": "./out/extension/main.cjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "bin": {
    "calc2js": "bin/cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edhey/calcjs-langium.git"
  },
  "scripts": {
    "esbuild-base": "esbuild ./src/extension/main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "build": "tsc -b tsconfig.src.json && node esbuild.mjs && npm run syntax",
    "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.src.json --watch\" \"node esbuild.mjs --watch\"",
    "lint": "eslint src --ext ts",
    "langium:generate": "langium generate",
    "langium:generate:production": "langium generate --mode=production",
    "langium:watch": "langium generate --watch",
    "langium:generate:build": "langium generate && npm run build",
    "vscode:prepublish": "npm run build && npm run lint",
    "test": "npm run build && tsx ./node_modules/.bin/mocha test/ --timeout 5000",
    "test:example": "mocha test/ --grep 'Example Test' --timeout 5000",
    "test:simple": "mocha test/ --grep 'Simple Test' --timeout 5000",
    "test:hard": "mocha test/ --grep 'Hard Test' --timeout 5000",
    "test:error": "mocha test/ --grep 'Error Test' --timeout 5000",
    "test:transpile": "mocha test/ --grep 'Transpile Test' --timeout 5000",
    "test:run": "mocha test/ --grep 'Run Test' --timeout 5000",
    "test:vitest": "vitest run",
    "compile": "jison src/grammar.jison src/lexer.l -o src/calc.cjs",
    "cov": "nyc npm run test",
    "report": "nyc --report --reporter=html --report-dir=docs/coverage -x src/template.js npm run test",
    "coverage": "c8 --reporter=html --reporter=text --report-dir='docs/coverage' npm run test",
    "jsdocs": "jsdoc -c jsdoc.json",
    "clean": "rm -f src/calc.cjs && npm run clean:docs",
    "clean:docs": "rm -rf docs/coverage docs/typedoc",
    "typedoc": "typedoc --options typedoc.json",
    "docs": "npm run clean:docs && npm run typedoc && npm run coverage && rm -rf docs/coverage/tmp",
    "dev": "http-server -c-1 -o docs",
    "trans": "./bin/cli --verbose",
    "exec": "./bin/cli --run",
    "syntax": "node ./src/language/syntaxes-post-processing.js",
    "pack:clean": "npm run langium:generate:build && find out -name '*.map' -delete"
  },
  "keywords": [
    "ull",
    "jison",
    "espree",
    "compiler"
  ],
  "author": "Himar Edhey Hernández Alonso <alu0101552392@ull.edu.es> (https://github.com/Edhey)",
  "license": "ISC",
  "dependencies": {
    "ast-types": "^0.14.2",
    "callable-instance": "^2.0.0",
    "chalk": "~5.3.0",
    "commander": "^10.0.0",
    "espree": "^10.3.0",
    "langium": "~3.5.0",
    "mathjs": "^14.2.1",
    "recast": "^0.23.10",
    "template-file": "^6.0.1",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver": "~9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "~1.67.0",
    "@typescript-eslint/eslint-plugin": "~7.3.1",
    "@typescript-eslint/parser": "~7.3.1",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "concurrently": "~8.2.1",
    "esbuild": "~0.20.2",
    "eslint": "~8.57.0",
    "http-server": "^14.1.1",
    "langium-cli": "~3.5.0",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~5.1.6",
    "vitest": "~1.4.0"
  },
  "volta": {
    "node": "18.19.1",
    "npm": "10.2.4"
  },
  "engines": {
    "vscode": "^1.67.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "calc-script",
        "aliases": [
          "CalcScript",
          "calc-script"
        ],
        "extensions": [
          ".calc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "calc-script",
        "scopeName": "source.calc-script",
        "path": "syntaxes/calc-script.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:calc-script"
  ]
}
