{
    "compilerOptions": {
        "target": "ES2017",
        "module": "Node16",
        "lib": [
            "ESNext"
        ],
        "sourceMap": true,
        "outDir": "out",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "moduleResolution": "Node16",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
, "src/code-generation/code-generation.js", "src/code-generation/transpile.js", "src/code-generation/write-code.js", "src/cli/main.ts"    ],
    "exclude": [
        "out",
        "node_modules"
    ]
}
