{
  "source": {
    "include": [
      "src"
    ],
    "includePattern": ".+\\.(js|jsdoc|jsx|ts|tsx)$",
    "exclude": [
      "src/language/generated",
      "src/types"
    ]
  },
  "plugins": [
    "plugins/markdown",
    "node_modules/jsdoc-babel"
  ],
  "opts": {
    "destination": "./docs/jsdoc",
    "recurse": true,
    "template": "node_modules/clean-jsdoc-theme",
    "theme_opts": {
      "default_theme": "light",
      "homepageTitle": "Scope-intro documentation",
      "menu": [
        {
          "title": "PL Lab scope-intro Description",
          "link": "https://apuntes-pl.vercel.app/labs/scope-intro",
          "target": "_self"
        },
        {
          "title": "Coverage Report",
          "link": "../coverage/",
          "target": "_self"
        },
        {
          "title": "Lab documentation",
          "link": "../",
          "target": "_self"
        }
      ]
    }
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": false
  },
  "markdown": {
    "hardwrap": false,
    "idInHeadings": true
  }
}